    {
      "a": 6,
      "b": 44,
      "text": "تخيل إنك نايم بغرفتك",
      "speaker": "narrator"
    },
    {
      "a": 48,
      "b": 127,
      "text": "وفجأه تسمع صوت أحد يتنفس من داخل الخزانه",
      "speaker": "narrator"
    },
    {
      "a": 136,
      "b": 162,
      "text": "تفتح عيونك",
      "speaker": "narrator"
    },
    {
      "a": 170,
      "b": 233,
      "text": "وتلاحظ إن باب الخزانه يتحرك بشويش",
      "speaker": "narrator"
    },
    {
      "a": 241,
      "b": 269,
      "text": "تقوم من سريرك",
      "speaker": "narrator"
    },
    {
      "a": 276,
      "b": 326,
      "text": "وتمشي باتجاهها",
      "speaker": "narrator"
    },
    {
      "a": 334,
      "b": 376,
      "text": "وكل ما تقرب تسمع أحد يهمس باسمك",
      "speaker": "narrator"
    },
    {
      "a": 392,
      "b": 420,
      "text": "تمد يدك للمقبض",
      "speaker": "narrator"
    },
    {
      "a": 421,
      "b": 466,
      "text": "وفجأه يرن جوالك",
      "speaker": "narrator"
    },
    {
      "a": 472,
      "b": 513,
      "text": "رقم غريب يتصل عليك",
      "speaker": "narrator"
    },
    {
      "a": 517,
      "b": 566,
      "text": "ترد وتسمع صوت رجال كبير",
      "speaker": "narrator"
    },
    {
      "a": 567,
      "b": 654,
      "text": "كأنه يتكلم من مسجل قديم يقول لك بصوت مرعوب",
      "speaker": "narrator"
    },
    {
      "a": 657,
      "b": 688,
      "text": "لا تفتح الخزانه",
      "speaker": "caller"
    },
    {
      "a": 690,
      "b": 722,
      "text": "أنا محبوس داخلها",
      "speaker": "caller"
    },
    {
      "a": 727,
      "b": 757,
      "text": "تتجمد بمكانك",
      "speaker": "narrator"
    },
    {
      "a": 761,
      "b": 812,
      "text": "وفجأه ينفتح باب الخزانه شوي",
      "speaker": "narrator"
    },
    {
      "a": 815,
      "b": 865,
      "text": "وتسمع صوت ثاني من داخلها يقول",
      "speaker": "narrator"
    },
    {
      "a": 867,
      "b": 938,
      "text": "لا تصدقه أنا اللي اتصلت عليك",
