{
  "name": "amberframe-animation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AmberFrame Animation Studio — Reusable 2D Animated Story Engine (من داخل الخزانة & هل تعرف إنك تحلم؟)",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3430",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate_amberframe.mjs",
    "validate:dreams": "node scripts/validate_episode.mjs",
    "render:board": "remotion render src/index.ts KhizanatAlGhurfaBoard out/storyboard_frames --image-format=png --sequence",
    "render:cast": "remotion still src/index.ts Cast out/cast.png",
    "render:cpu": "remotion render src/index.ts KhizanatAlGhurfa out/Khizanat_Al_Ghurfa_1080p.mp4 --codec=h264 --crf=15 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.8.2"
  }
}
